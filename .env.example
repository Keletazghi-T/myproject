# Render backend: enter these values in Render's environment settings.
SPRING_PROFILES_ACTIVE=production
JDBC_DATABASE_URL=jdbc:postgresql://YOUR_NEON_HOST/neondb?sslmode=require
DATABASE_USERNAME=YOUR_NEON_ROLE
DATABASE_PASSWORD=YOUR_NEON_PASSWORD
FRONTEND_ORIGIN=https://YOUR_PROJECT.vercel.app

# Vercel frontend: set in Vercel's environment settings.
RENDER_API_ORIGIN=https://YOUR_BACKEND.onrender.com
